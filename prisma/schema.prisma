// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Editable RSP snapshot for public share links (COGS → 3 regional scenarios).
model RspShare {
  id        String   @id @default(cuid())
  token     String   @unique
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Saved RSP workspace sessions (history + optional public token).
model RspSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// "single" | "bulk"
  kind      String   @default("single")
  payload   Json
  /// When kind=bulk: array of { id, label, cogs }
  bulkRows  Json?
  token     String?  @unique
}
