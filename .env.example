# Copy to .env and fill in. Never commit .env.

# Postgres (Neon): RSP share links. Run `pnpm prisma db push` after setting.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Odoo JSON-RPC (server-side only)
ODOO_URL=https://your-instance.odoo.com
ODOO_DATABASE=your_db
ODOO_USERNAME=your@email.com
# ODOO_LOGIN is accepted as an alias for ODOO_USERNAME
ODOO_API_KEY=your_api_key_or_password

# OpenRouter (AI insights — trends, signals, overview)
OPENROUTER_API_KEY=
# Optional model id, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=
# Optional: web-aware research for global toy trends (e.g. perplexity/sonar, perplexity/sonar-pro)
OPENROUTER_TRENDING_MODEL=

# Used for OpenRouter HTTP Referer header when set
NEXT_PUBLIC_APP_URL=http://localhost:3000
